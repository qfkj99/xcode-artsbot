{
  "api_token": {
    "description": "API Token",
    "type": "string",
    "default": "",
    "secret": true,
    "hint": "接口鉴权 Token，只填 Token 本身即可（不用带 Bearer 前缀）。",
    "obvious_hint": true
  },
  "api_user": {
    "description": "New-Api-User",
    "type": "string",
    "default": "2",
    "hint": "请求头 New-Api-User 的值。"
  },
  "api_url": {
    "description": "快照接口地址",
    "type": "string",
    "default": "https://xcodebest.com/api/group-monitor/snapshot/details"
  },
  "range": {
    "description": "统计时间范围",
    "type": "string",
    "default": "24h",
    "hint": "作为 range 参数传给接口，例如 24h。"
  },
  "request_timeout": {
    "description": "请求超时（秒）",
    "type": "int",
    "default": 15,
    "slider": {
      "min": 3,
      "max": 60,
      "step": 1
    }
  },
  "keywords": {
    "description": "触发关键词",
    "type": "list",
    "default": [
      "状态检查"
    ],
    "hint": "群消息内容与任意一个关键词完全一致时触发（会忽略首尾空格），无需 @ 机器人。",
    "obvious_hint": true
  },
  "ai_wake_keywords": {
    "description": "AI 唤醒词",
    "type": "list",
    "default": [
      "大肥鱼"
    ],
    "hint": "群消息里只要包含其中任意一个词（不用 @），就像 @机器人 一样 100% 触发 AI 回复，使用机器人原本的 AI、人格和对话记录，消息原文完整交给 AI。留空则关闭。所有群都生效。",
    "obvious_hint": true
  },
  "bare_mention_use_recent": {
    "description": "单独 @ 时回复刚才的消息",
    "type": "bool",
    "default": true,
    "hint": "群友先发了一段话（或图片），再单独 @机器人 时，把他刚才还没被回复的消息交给 AI 回复。AstrBot 默认遇到单独的 @ 不会回复。"
  },
  "bare_mention_window_minutes": {
    "description": "往前找多久的消息（分钟）",
    "type": "int",
    "default": 5,
    "slider": {
      "min": 1,
      "max": 60,
      "step": 1
    },
    "hint": "只取这个人在这段时间内、同一个群里发的消息，最多最近 5 条。"
  },
  "only_whitelisted_groups": {
    "description": "仅在白名单群中响应",
    "type": "bool",
    "default": true,
    "hint": "开启后只有「群配置」页面里已启用的群才会响应；关闭后所有群都响应。群配置在：插件详情页 → 页面 → 群配置。",
    "obvious_hint": true
  },
  "groups": {
    "description": "群配置",
    "type": "template_list",
    "hint": "在插件详情页的「群配置」页面里管理。",
    "templates": {
      "group": {
        "name": "群",
        "display_item": "remark",
        "items": {
          "session": {
            "description": "群会话",
            "type": "string",
            "default": "",
            "hint": "群会话 ID"
          },
          "remark": {
            "description": "群名",
            "type": "string",
            "default": "",
            "hint": "保存时的群名，用于显示。"
          },
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true
          },
          "cooldown_seconds": {
            "description": "冷却时间（秒）",
            "type": "int",
            "default": 5,
            "hint": "该群内两次触发的最小间隔，冷却期内的重复触发会被忽略。0 表示不限制。"
          }
        }
      }
    },
    "invisible": true
  },
  "default_cooldown_seconds": {
    "description": "默认冷却时间（秒）",
    "type": "int",
    "default": 5,
    "hint": "在群配置页面添加新群时的默认冷却时间；关闭白名单后，没有单独配置的群也使用它（每个群独立计时）。"
  },
  "pending_text": {
    "description": "获取中提示",
    "type": "string",
    "default": "正在获取状态~",
    "hint": "识别到关键词后先立即回复这句话，再去获取状态。留空则不发送。"
  },
  "header_text": {
    "description": "开头自定义文字",
    "type": "text",
    "default": "",
    "hint": "显示在摘要上方，留空则不显示。"
  },
  "show_summary": {
    "description": "显示状态摘要",
    "type": "bool",
    "default": true,
    "hint": "在截图旁附带各状态数量，以及异常、降级、暂无数据的分组名单。"
  },
  "footer_text": {
    "description": "结尾自定义文字",
    "type": "text",
    "default": "",
    "hint": "显示在摘要下方，留空则不显示。"
  },
  "fail_message": {
    "description": "查询失败时的回复",
    "type": "string",
    "default": "状态查询失败，请稍后再试。"
  },
  "broadcast_interval_seconds": {
    "description": "群发间隔（秒）",
    "type": "float",
    "default": 2.5,
    "slider": {
      "min": 1,
      "max": 10,
      "step": 0.5
    },
    "hint": "「群发通知」每发一条消息后的等待时间。QQ 未认证机器人每分钟最多 30 条主动消息，2.5 秒约每分钟 24 条。"
  }
}
